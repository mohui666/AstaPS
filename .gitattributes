# Auto detect text files and perform LF normalization
* text=auto

# bat files should be checked out with CRLF line endings
*.bat text eol=crlf

# shell scripts should be checked out with LF line endings
gradlew text eol=lf

# Unified patch context lines preserve their required leading space.
tools/quest-resource-patches/7.1-story-repairs.patch whitespace=-blank-at-eol,-space-before-tab
