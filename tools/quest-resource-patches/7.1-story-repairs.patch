diff --git a/Scripts/Common/QuestReconstruction/Story.lua b/Scripts/Common/QuestReconstruction/Story.lua
new file mode 100644
index 0000000000000000000000000000000000000000..7855fbf5465a1e5248035a5692d775a5968f93ff
--- /dev/null
+++ b/Scripts/Common/QuestReconstruction/Story.lua
@@ -0,0 +1,92 @@
+-- AstaPS reconstruction bridge. Original quest dialogue/FinishPlot stays with the client actor.
+-- Require only from groups explicitly listed in QuestStoryReconstruction.json.
+local story = assert(story_reconstruction, "missing explicit story_reconstruction definition")
+base_info = { group_id = story.group_id }
+monsters = monsters or {}
+npcs = npcs or {}
+regions = regions or {}
+variables = variables or {}
+gadgets = gadgets or {}
+triggers = triggers or {}
+local control_id = story.controller_config_id or 900001
+local control_exists = false
+for _, gadget in pairs(gadgets) do
+  if gadget.config_id == control_id then control_exists = true end
+end
+if not control_exists then
+  table.insert(gadgets, { config_id = control_id,
+    gadget_id = story.controller_gadget_id or 70350081,
+    pos = { x = story.position.x, y = story.position.y, z = story.position.z },
+    rot = { x = 0, y = 0, z = 0 }, level = 1, state = 0 })
+end
+-- Only explicitly marked scenery reconstructions gain a physical second-variant lamp.
+if story.scenery_variant then
+  table.insert(gadgets, { config_id = 900002, gadget_id = 70330565,
+    pos = { x = story.position.x + 2.5, y = story.position.y, z = story.position.z },
+    rot = { x = 0, y = 0, z = 0 }, level = 1, state = 202 })
+end
+init_config = init_config or { suite = 1, end_suite = 0, rand_suite = false }
+init_config.io_type = 1
+init_config.sub_flow_type = 1
+sub_flow_type = 1
+local story_bridges = {
+  { config_id = 900010, name = "STORY_GROUP_LOAD", event = EventType.EVENT_GROUP_LOAD,
+    source = "", condition = "", action = "action_STORY_GROUP_LOAD" },
+  { config_id = 900011, name = "STORY_GADGET_CREATE", event = EventType.EVENT_GADGET_CREATE,
+    source = "", condition = "", action = "action_STORY_GROUP_LOAD" },
+  { config_id = 900012, name = "STORY_SELECT_OPTION", event = EventType.EVENT_SELECT_OPTION,
+    source = "", condition = "", action = "action_STORY_SELECT_OPTION" },
+  { config_id = 900013, name = "STORY_MONSTER_DIE", event = EventType.EVENT_ANY_MONSTER_DIE,
+    source = "", condition = "", action = "action_STORY_MONSTER_DIE" }
+}
+for _, bridge in ipairs(story_bridges) do
+  bridge.trigger_count = -1
+  table.insert(triggers, bridge)
+end
+-- Native71 requires actual flow-suite metadata. Keeping an ordinary `suites` table
+-- would make the Java loader ignore suite_disk, despite io_type above being FLOW.
+local ordinary = suites or {}
+suites = nil
+suite_disk = {}
+local gadget_states = {}
+for _, gadget in ipairs(gadgets) do gadget_states[gadget.config_id] = gadget.state or 0 end
+local monster_poses = {}
+for _, monster in ipairs(monsters) do monster_poses[monster.config_id] = monster.pose_id or 0 end
+for index = 1, math.max(story.suite_count, #ordinary) do
+  local source = ordinary[index] or {}
+  local names, flow_gadgets, flow_monsters = {}, {}, {}
+  local has_control = false
+  for _, name in ipairs(source.triggers or {}) do table.insert(names, name) end
+  for _, bridge in ipairs(story_bridges) do table.insert(names, bridge.name) end
+  -- Preserve authored spawn IDs and states in their original suite only.
+  for _, id in ipairs(source.gadgets or {}) do
+    table.insert(flow_gadgets, { config_id = id, state = gadget_states[id] or 0 })
+    if id == control_id then has_control = true end
+  end
+  if not has_control then table.insert(flow_gadgets, { config_id = control_id, state = 0 }) end
+  if story.scenery_variant and index > 1 then
+    table.insert(flow_gadgets, { config_id = 900002, state = 202 })
+  end
+  for _, id in ipairs(source.monsters or {}) do
+    table.insert(flow_monsters, { config_id = id, pose_id = monster_poses[id] or 0 })
+  end
+  suite_disk[index] = { gadgets = flow_gadgets, monsters = flow_monsters,
+    npcs = source.npcs or {}, regions = source.regions or {},
+    variables = source.variables or {}, triggers = names }
+end
+
+function action_STORY_GROUP_LOAD(context, evt)
+  ScriptLib.ReconstructionStoryGroupLoaded(context)
+  return 0
+end
+
+function action_STORY_SELECT_OPTION(context, evt)
+  -- Rejected selections remain retryable. Returning -1 would deregister an unlimited trigger.
+  ScriptLib.ReconstructionStoryInteract(context, evt.param1, evt.param2)
+  return 0
+end
+
+function action_STORY_MONSTER_DIE(context, evt)
+  ScriptLib.ReconstructionStoryMonsterDied(context, evt.param1)
+  return 0
+end
